# Banco PostgreSQL local
POSTGRES_DB=materialcrm
POSTGRES_USER=materialcrm
POSTGRES_PASSWORD=ALTERE_PARA_UMA_SENHA_FORTE

# Segredo JWT exclusivo desta instalação: gere 32 bytes aleatórios em Base64.
APP_JWT_SECRET_BASE64=GERE_UMA_CHAVE_ALEATORIA_BASE64_DE_32_BYTES
APP_JWT_TTL_MINUTES=480

# Primeiro administrador: defina antes do primeiro início.
# Após a criação, remova BOOTSTRAP_ADMIN_PASSWORD do .env.
BOOTSTRAP_ADMIN_EMAIL=admin@minhaloja.local
BOOTSTRAP_ADMIN_PASSWORD=

BACKEND_PORT=8081
FRONTEND_PORT=8080
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

# Preencha apenas no primeiro início e remova a senha em seguida.
MATERIALCRM_BOOTSTRAP_COMPANY_NAME=
MATERIALCRM_BOOTSTRAP_COMPANY_TAX_ID=
MATERIALCRM_BOOTSTRAP_ADMIN_EMAIL=
MATERIALCRM_BOOTSTRAP_ADMIN_PASSWORD=
