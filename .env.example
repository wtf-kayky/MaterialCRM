# Supabase Cloud — use o host e usuário exibidos em Project Settings > Database.
# Para redes IPv4, prefira a conexão pooler em modo Session para a API Spring de longa duração.
SUPABASE_DB_HOST=COLE_O_HOST_DO_SUPABASE_AQUI
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=COLOQUE_A_SENHA_DO_BANCO_AQUI

# Portas publicadas somente na máquina/servidor local.
BACKEND_PORT=8081
FRONTEND_PORT=8080

# Pool JDBC conservador para começar; ajuste após testes de carga.
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
