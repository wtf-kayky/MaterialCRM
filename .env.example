# PostgreSQL local — utilizado pelo MaterialCRM Local.
# Escolha uma senha forte e exclusiva; não compartilhe este arquivo.
POSTGRES_DB=materialcrm
POSTGRES_USER=materialcrm
POSTGRES_PASSWORD=ALTERE_PARA_UMA_SENHA_FORTE

# Portas publicadas no servidor da loja.
BACKEND_PORT=8081
FRONTEND_PORT=8080

# Pool JDBC inicial; ajustar após testes de carga.
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

# TEMPORÁRIO: autenticação ainda utiliza Supabase enquanto o login local
# é implementado na próxima entrega. Estes parâmetros serão removidos.
SUPABASE_JWT_ISSUER=https://hmkkzlstjpnsfrwqcjax.supabase.co/auth/v1
SUPABASE_JWKS_URI=https://hmkkzlstjpnsfrwqcjax.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# TEMPORÁRIO: o frontend ainda usa Supabase Auth nesta fase de transição.
VITE_SUPABASE_URL=https://hmkkzlstjpnsfrwqcjax.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=COLE_A_PUBLISHABLE_KEY_DO_SUPABASE_AQUI
